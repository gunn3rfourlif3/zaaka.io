# WordPress core — managed by the installer, not by this repo
/wp-admin/
/wp-includes/
/index.php
/wp-*.php
/xmlrpc.php
/license.txt
/readme.html
/.htaccess

# Everything in wp-content except this theme
/wp-content/*
!/wp-content/themes/
/wp-content/themes/*
!/wp-content/themes/zaaka-studio/

# Local + build noise
node_modules/
vendor/
*.log
.env
.env.*
.DS_Store
Thumbs.db
/tools/__pycache__/
/tools/out/

# Saved page captures and decoded diagnostics — evidence for a specific bug
# hunt, kept locally but not part of the project.
/docs/_diagnostics/

# Built theme archive — regenerate with tools/build-zip.sh
/zaaka-studio.zip

# Preview harness output
/tools/preview/out/
